# firebase / FCM (Android push). google-services.json is client config but we
# keep it out of git; EAS pulls it from a secret file (see docs). The
# service-account key is a real secret — never commit it.
google-services.json
*-firebase-adminsdk-*.json
fcm-service-account*.json
play-store-service-account.json

# supabase
supabase/.branches
supabase/.temp

# testing
coverage/
hommie-upload-keystore.txt

# admin-web (Next.js)
admin-web/.next/
admin-web/next-env.d.ts

# Android signing (never commit)
credentials.json
*.jks
*.keystore
!android/app/debug.keystore
*.aab
.vercel
.env*
