{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "EXPO_PUBLIC_ENV": "development" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": { "simulator": false },
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_ENV": "preview" }
    },
    "production": {
      "channel": "production",
      "env": { "EXPO_PUBLIC_ENV": "production" },
      "ios": { "credentialsSource": "local" }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6811326854"
      },
      "android": {
        "serviceAccountKeyPath": "./play-store-service-account.json",
        "track": "internal"
      }
    }
  }
}
