# ---------------------------------------------------------------------------
# Hommie — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Only EXPO_PUBLIC_* variables are available in the app bundle at runtime.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon/public key. This is safe to ship in the client.
# It is NOT the service_role key — the service_role key must never be placed
# in this file or anywhere in the mobile app.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Toggle the analytics pipeline. When "false", events are collected by the
# central analytics interface but not forwarded to any provider.
EXPO_PUBLIC_ANALYTICS_ENABLED=false

# Environment label: development | preview | production
EXPO_PUBLIC_ENV=development

# PostHog (optional) — Project Settings > Project API Key / API Host in the
# PostHog dashboard. Analytics stays console-only until both are set.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=

# ---------------------------------------------------------------------------
# Google Sign-In (native). Create an OAuth 2.0 "Web application" client and an
# "iOS" client in Google Cloud Console for the project linked to Supabase.
#  - WEB_CLIENT_ID   : the Web client id — also paste it into Supabase
#                      Auth > Providers > Google ("Client ID").
#  - IOS_CLIENT_ID   : the iOS client id.
#  - IOS_URL_SCHEME  : the iOS client id reversed, i.e. the value under
#                      "iOS URL scheme" in the client details
#                      (com.googleusercontent.apps.XXXXXXXX). Build-time only.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Apple Sign-In is built but stays hidden (and its native entitlement is left
# out of the build) until this is "true". Turn it on after the Apple Developer
# portal + Supabase Apple provider setup is done. Keep "false" for now.
EXPO_PUBLIC_APPLE_SIGN_IN_ENABLED=false

# ---------------------------------------------------------------------------
# Build-time only (EAS). Not exposed to the app.
# ---------------------------------------------------------------------------
EAS_PROJECT_ID=

# ---------------------------------------------------------------------------
# Server-side only — used by supabase CLI / edge functions / seed scripts.
# DO NOT prefix with EXPO_PUBLIC_. DO NOT import into any file under app/ or src/.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
