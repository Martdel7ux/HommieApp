# ---------------------------------------------------------------------------
# Hommie — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Only EXPO_PUBLIC_* variables are available in the app bundle at runtime.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon/public key. This is safe to ship in the client.
# It is NOT the service_role key — the service_role key must never be placed
# in this file or anywhere in the mobile app.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Toggle the analytics pipeline. When "false", events are collected by the
# central analytics interface but not forwarded to any provider.
EXPO_PUBLIC_ANALYTICS_ENABLED=false

# Environment label: development | preview | production
EXPO_PUBLIC_ENV=development

# ---------------------------------------------------------------------------
# Build-time only (EAS). Not exposed to the app.
# ---------------------------------------------------------------------------
EAS_PROJECT_ID=

# ---------------------------------------------------------------------------
# Server-side only — used by supabase CLI / edge functions / seed scripts.
# DO NOT prefix with EXPO_PUBLIC_. DO NOT import into any file under app/ or src/.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
